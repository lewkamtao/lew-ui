## 组件间依赖

### 允许的依赖关系

```typescript
// ✅ 组件可以依赖公共组件
import CommonIcon from 'lew-ui/_components/CommonIcon.vue'

// ✅ 组件可以使用工具函数
import { object2class } from 'lew-ui/utils'

// ✅ 组件可以使用全局类型
import type { Size, Color } from 'lew-ui/types'

// ✅ 复合组件之间的依赖（父子关系）
// LewCheckboxGroup 可以导入 LewCheckbox
import LewCheckbox from './LewCheckbox.vue'
```

### 禁止的依赖关系

```typescript
// ❌ 禁止组件直接依赖其他业务组件
// import LewButton from '../button/src/LewButton.vue'
// 应该由用户自己组合

// ❌ 禁止循环依赖
// ComponentA 导入 ComponentB，同时 ComponentB 导入 ComponentA

// ❌ 禁止跨模块的深层导入
// import { helper } from '../../data/table/src/utils'
// 应该提取到公共 utils

// ❌ 禁止依赖未导出的内部实现
// import { _internalHelper } from 'lew-ui/_internal'
```

## 公共代码管理

### 目录结构

```
lib/
├── _components/      # 内部公共组件（不对外导出）
│   ├── CommonIcon.vue
│   └── CommonLoading.vue
├── _utils/          # 内部工具函数（不对外导出）
│   └── internal-helper.ts
├── utils/           # 对外公共工具
│   ├── object2class.ts
│   └── index.ts
├── types/           # 公共类型定义
│   ├── common.ts
│   └── index.ts
└── components/      # 组件
    └── ...
```

### 公共组件规范

```typescript
// lib/_components/CommonIcon.vue
// ✅ 内部公共组件（所有组件共用）
<script setup lang="ts">
import { computed } from 'vue'
import * as Icons from '@lucide/vue'

const props = defineProps<{
  type: string
  size?: number
  color?: string
}>()

const IconComponent = computed(() => {
  return Icons[props.type] || Icons.HelpCircle
})
</script>

<template>
  <component
    :is="IconComponent"
    :size="size"
    :color="color"
  />
</template>
```

### 公共工具函数

```typescript
// lib/utils/object2class.ts
/**
 * 将对象转换为 BEM 类名
 * @param base - 基础类名（如 'lew-button'）
 * @param modifiers - 修饰符对象
 * @returns 类名字符串
 */
export function object2class(
  base: string,
  modifiers: Record<string, any>
): string {
  const classes = [base]
  
  for (const [key, value] of Object.entries(modifiers)) {
    if (value === true) {
      // boolean: lew-button-loading
      classes.push(`${base}-${key}`)
    } else if (value && value !== false) {
      // string/number: lew-button-size-small
      classes.push(`${base}-${key}-${value}`)
    }
  }
  
  return classes.join(' ')
}

// 使用示例
object2class('lew-button', {
  size: 'small',      // -> lew-button-size-small
  type: 'primary',    // -> lew-button-type-primary
  loading: true,      // -> lew-button-loading
  disabled: false     // -> 不生成
})
// 结果: 'lew-button lew-button-size-small lew-button-type-primary lew-button-loading'
```

