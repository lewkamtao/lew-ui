{
  "name": "lew-ui",
  "type": "module",
  "version": "2.8.2",
  "description": "A Component Library for Vue3.js.",
  "author": "lewkamtao",
  "license": "MIT",
  "keywords": [
    "vue3",
    "components",
    "ui library",
    "frontend"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "package.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build:docs": "pnpm lint:fix && pnpm lint:css:fix && node scripts/extract-types.js && vue-tsc --noEmit && vite build -c vite.config.docs.ts",
    "build:lib": "vue-tsc --noEmit && vite build -c vite.config.lib.ts",
    "version:patch": "node ./bump-version.js",
    "analyze": "ANALYZE=true vite build -c vite.config.lib.ts",
    "format": "pnpm lint:fix && pnpm lint:css:fix && node scripts/extract-types.js",
    "format:types": "node scripts/extract-types.js",
    "sort:types": "node scripts/sort-components.js",
    "lint:css": "stylelint \"lib/**/*.{css,scss}\" \"docs/**/*.{css,scss}\"",
    "lint:css:fix": "stylelint \"lib/**/*.{css,scss}\" \"docs/**/*.{css,scss}\" --fix",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.5.3"
  },
  "dependencies": {
    "@lucide/vue": "^1.24.0",
    "@vueuse/core": "^14.3.0",
    "csstype": "^3.1.3",
    "dayjs": "^1.11.21",
    "expr-eval-fork": "^3.0.3",
    "lodash-es": "^4.17.21",
    "tippy.js": "^6.3.7",
    "vue-i18n": "^11.4.6",
    "yup": "^1.2.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.16.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "axios": "^1.18.1",
    "eslint": "^10.7.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "jsdom": "^29.1.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass": "^1.101.0",
    "shiki": "3.12.2",
    "shiki-block-vue": "1.1.2",
    "stylelint": "17.14.0",
    "stylelint-config-recess-order": "7.7.0",
    "stylelint-order": "^8.1.1",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.8.3",
    "unplugin-auto-import": "^21.0.0",
    "vite": "8.1.4",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-zip-pack": "^1.2.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.39",
    "vue-router": "^4.0.13",
    "vue-tsc": "^3.3.7",
    "vuedraggable": "^4.1.0"
  },
  "pnpm": {
    "overrides": {
      "form-data": ">=4.0.6",
      "js-yaml": ">=4.2.0",
      "esbuild": ">=0.28.1"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "@parcel/watcher"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "vite": "8"
      }
    }
  }
}
